{
  "name": "@bydtech/pg-backup-verify",
  "version": "0.1.0",
  "description": "Prove a Postgres backup restores: restore the dump into a scratch database, compare every table's row count against the source, and drop the scratch database again.",
  "keywords": [
    "postgres",
    "postgresql",
    "backup",
    "restore",
    "pg_dump",
    "pg_restore",
    "verify",
    "disaster-recovery",
    "cli"
  ],
  "homepage": "https://github.com/BYDTechSolutions/pg-backup-verify#readme",
  "bugs": {
    "url": "https://github.com/BYDTechSolutions/pg-backup-verify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYDTechSolutions/pg-backup-verify.git"
  },
  "license": "MIT",
  "author": "BYD Tech <sales.bydtech@gmail.com> (https://bydtech.in)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pg-backup-verify": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
